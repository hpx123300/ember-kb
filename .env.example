# 模型配置（把 .env.example 复制为 .env 并填写）
# 任何 OpenAI 兼容接口都可以，换供应商只改 BASE_URL 与 MODEL
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 数据库：默认 SQLite 文件，生产直接换成 MySQL
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/ember?charset=utf8mb4

# 鉴权：生产必须改，改了以后已签发的 token 全部失效
EMBER_JWT_SECRET=please-change-this-to-a-random-32-plus-char-secret
EMBER_TOKEN_TTL_HOURS=12
# 首次启动创建的管理员账号（只在该用户名不存在时写入）
EMBER_ADMIN_USER=admin
EMBER_ADMIN_PASSWORD=admin12345

# MCP Server 以哪个身份运行（决定它能检索到哪些部门资料）
EMBER_MCP_AUDIENCE=全员

# 检索参数（一般不用改）
RAG_CHUNK_MAX_CHARS=500
RAG_CHUNK_OVERLAP_CHARS=80
RAG_RRF_K=60
